# ============================================================
# Environment Variables Template — RAG Chatbot Platform
# ============================================================
# HOW TO USE THIS FILE:
#   1. Copy this file:  cp .env.example .env  (Linux/Mac)
#                       OR
#                       Copy-Item .env.example .env  (Windows PowerShell)
#   2. Edit .env and replace placeholder values with real ones
#   3. NEVER commit .env to Git (it's in .gitignore)
# ============================================================

# --- Application Settings ---
APP_NAME=RAG Chatbot Platform
APP_VERSION=0.4.0
APP_ENV=development

# --- API Settings ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging Settings ---
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- OpenAI Settings (required from Day 7 onwards) ---
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OWN_KEY
OPENAI_MODEL=gpt-4

# --- Database Settings (to be configured later) ---
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb

# --- ChromaDB Settings (to be configured later) ---
CHROMA_PERSIST_DIR=./chroma_db